# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_collab

# ---- Redis (BullMQ 队列 / 缓存) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (better-auth) ----
AUTH_SECRET=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- LLM Gateway ----
# 主力模型（任务拆分/洞察）
ANTHROPIC_API_KEY=
# 兜底/国内部署适配（可留空）
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=claude-sonnet-4-6
LLM_COMPLEX_MODEL=claude-opus-4-8
# 单 issue 每日成本护栏（美元）
LLM_DAILY_COST_CAP_PER_ISSUE=2.00

# ---- GitHub Integration (DEV-7) ----
GITHUB_WEBHOOK_SECRET=

# ---- App ----
API_PORT=3001
WEB_PORT=3000
